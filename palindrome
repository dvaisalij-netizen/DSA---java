class Solution {
    public boolean isPalindrome(int n) {
        // code here
        int temp = Math.abs(n);
        int orginal=temp;
        int rev=0;
        while(temp>0){
            int digit=temp%10;
            rev=rev*10+digit;
            temp=temp/10;
        }
       return orginal==rev;
    }
}
