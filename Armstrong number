class Solution {
    static boolean armstrongNumber(int n) {
        int temp=n;
        int count=0;
        
    while(temp>0){
        int digit=temp%10;
        count++;
        temp=temp/10;
    }
    temp=n;
    int sum=0;
    while(temp>0){
        int digit=temp%10;
        sum+= (int)Math.pow(digit,count);
        temp=temp/10;
    }
    return sum==n;
    }
}
